---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

// Datos del evento para el calendario
const evento = {
  titulo: "Boda Cesia & Luis",
  fecha: "20270220T160000",
  fechaFin: "20270220T230000",
  lugar: "Casa Venuat, Valle de Ángeles, Francisco Morazán, Honduras",
  descripcion: "Celebración del enlace matrimonial de Cesia Mejía y Luis Velásquez",
};

// Google Calendar URL
const googleCalUrl = `https://www.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(evento.titulo)}&dates=${evento.fecha}/${evento.fechaFin}&location=${encodeURIComponent(evento.lugar)}&details=${encodeURIComponent(evento.descripcion)}`;

// ICS content para Apple/Outlook
const icsContent = `BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Boda C&L//ES
BEGIN:VEVENT
DTSTART:${evento.fecha}
DTEND:${evento.fechaFin}
SUMMARY:${evento.titulo}
LOCATION:${evento.lugar}
DESCRIPTION:${evento.descripcion}
END:VEVENT
END:VCALENDAR`;
---

<Layout title="Save the Date — Cesia & Luis · 20 Feb 2027">
  <main class="relative min-h-screen bg-wedding-cream flex flex-col items-center justify-center overflow-hidden">
    
    <!-- Background elements -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-white/40 via-transparent to-white/40"></div>
      <div class="absolute top-[10%] left-[5%] w-72 h-72 rounded-full bg-wedding-sage/5 blur-3xl"></div>
      <div class="absolute bottom-[10%] right-[5%] w-80 h-80 rounded-full bg-wedding-gold/5 blur-3xl"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 w-full max-w-lg mx-auto px-6 py-16 text-center">
      
      <!-- Top decoration -->
      <div class="mb-8" data-animate="fade-down">
        <p class="text-xs uppercase tracking-[0.4em] text-wedding-sage font-serif-elegant">
          Reserva la fecha
        </p>
      </div>

      <!-- Photo -->
      <div class="relative w-56 h-56 md:w-64 md:h-64 mx-auto mb-10 rounded-full overflow-hidden shadow-2xl shadow-wedding-dark-green/10 border-4 border-white" data-animate="scale-in">
        <picture>
          <source media="(max-width: 640px)" srcset="/images/optimos/_DSC3356-mobile.webp" />
          <img
            src="/images/optimos/_DSC3356.webp"
            alt="Cesia y Luis"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </picture>
      </div>

      <!-- Names -->
      <div data-animate="fade-up">
        <h1 class="script-font text-6xl md:text-7xl text-wedding-dark-green mb-2">
          Cesia <span class="text-4xl md:text-5xl text-wedding-sage">&</span> Luis
        </h1>
        <div class="w-16 h-px bg-wedding-gold/50 mx-auto my-6"></div>
      </div>

      <!-- Date -->
      <div class="mb-10" data-animate="fade-up">
        <p class="font-serif-elegant text-2xl md:text-3xl text-wedding-dark-green uppercase tracking-widest mb-2">
          20 de Febrero
        </p>
        <p class="font-serif-elegant text-4xl md:text-5xl text-wedding-gold font-bold">
          2027
        </p>
        <p class="text-sm text-gray-500 mt-3 font-body">
          Sábado · 4:00 PM
        </p>
      </div>

      <!-- Venue -->
      <div class="mb-10" data-animate="fade-up">
        <p class="font-serif-elegant text-base text-wedding-dark-green uppercase tracking-wider mb-1">
          Casa Venuat
        </p>
        <p class="text-sm text-gray-500 font-body">
          Valle de Ángeles, Francisco Morazán
        </p>
      </div>

      <!-- Message -->
      <div class="mb-12 max-w-sm mx-auto" data-animate="fade-up">
        <p class="font-body italic text-gray-600 text-sm leading-relaxed">
          Pronto recibirás tu invitación formal con todos los detalles. 
          Por ahora, ¡reserva este día para celebrar con nosotros!
        </p>
      </div>

      <!-- Calendar Buttons -->
      <div class="space-y-3" data-animate="fade-up">
        <p class="text-xs uppercase tracking-widest text-wedding-sage font-serif-elegant mb-4">
          Guardar en calendario
        </p>
        
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <!-- Google Calendar -->
          <a
            href={googleCalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-wedding-dark-green text-white rounded-full font-serif-elegant text-sm uppercase tracking-wider shadow-lg hover:bg-wedding-gold hover:shadow-xl transition-all duration-300"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/>
            </svg>
            Google Calendar
          </a>

          <!-- Apple / Outlook (ICS) -->
          <button
            id="btn-ics"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-wedding-dark-green border-2 border-wedding-dark-green/20 rounded-full font-serif-elegant text-sm uppercase tracking-wider shadow-md hover:border-wedding-gold hover:text-wedding-gold hover:shadow-lg transition-all duration-300"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            Apple / Outlook
          </button>
        </div>
      </div>

      <!-- Footer -->
      <div class="mt-16" data-animate="fade-up">
        <div class="flex justify-center gap-2 mb-4">
          <div class="w-1 h-1 rounded-full bg-wedding-gold/40"></div>
          <div class="w-1 h-1 rounded-full bg-wedding-sage/40"></div>
          <div class="w-1 h-1 rounded-full bg-wedding-gold/40"></div>
        </div>
        <p class="text-xs text-gray-400">
          Con amor, Cesia & Luis 💍
        </p>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ icsContent }}>
  document.getElementById("btn-ics")?.addEventListener("click", () => {
    const blob = new Blob([icsContent], { type: "text/calendar;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "boda-cesia-luis.ics";
    a.click();
    URL.revokeObjectURL(url);
  });
</script>

<style>
  h1 {
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.04);
  }
</style>
