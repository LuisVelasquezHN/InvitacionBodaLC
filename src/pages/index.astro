---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout title="Boda Cesia & Luis — 20 de Febrero 2027">
  <main class="relative max-w-4xl mx-auto bg-white shadow-2xl overflow-hidden min-h-screen flex flex-col justify-center">
    
    <!-- Hero -->
    <header class="text-center pt-20 pb-8 px-4" data-animate="fade-down">
      <p class="text-sm uppercase tracking-[0.3em] text-wedding-sage mb-6 font-serif-elegant">
        Celebramos nuestro amor
      </p>
      <h1 class="font-serif-elegant text-5xl md:text-7xl text-wedding-dark-green mb-4 tracking-widest leading-tight">
        C <span class="text-wedding-sage">&</span> L
      </h1>
      <div class="w-24 h-px bg-wedding-gold/50 mx-auto my-6"></div>
    </header>

    <!-- Hero Image -->
    <div class="relative h-[50vh] md:h-[60vh] w-full overflow-hidden mx-4 md:mx-8 rounded-2xl self-center max-w-3xl" data-animate="fade-in">
      <picture>
        <source media="(max-width: 640px)" srcset="/images/optimos/_DSC3356-mobile.webp" />
        <img
          src="/images/optimos/_DSC3356.webp"
          alt="Cesia y Luis"
          class="w-full h-full object-cover object-center rounded-2xl"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent rounded-2xl"></div>
      <div class="absolute bottom-6 left-0 right-0 text-center">
        <p class="text-white/90 text-lg font-body italic drop-shadow-lg">20 de Febrero, 2027</p>
      </div>
    </div>

    <!-- Nombres -->
    <section class="text-center py-12 px-4" data-animate="fade-up">
      <h2 class="script-font text-6xl md:text-8xl text-wedding-dark-green mb-4">
        Cesia <span class="text-3xl md:text-5xl text-wedding-sage align-middle">&</span> Luis
      </h2>
      <p class="text-lg font-body italic text-gray-600 mb-8">
        Nos casamos
      </p>
      
      <div class="inline-block border-y border-wedding-gold/40 py-4 px-8">
        <p class="font-serif-elegant text-lg md:text-xl text-wedding-dark-green uppercase tracking-widest">
          Casa Venuat — Valle de Ángeles
        </p>
        <p class="text-sm text-gray-500 mt-1">Francisco Morazán, Honduras</p>
      </div>
    </section>

    <!-- Mensaje -->
    <section class="text-center pb-16 px-4" data-animate="fade-up">
      <div class="max-w-md mx-auto bg-wedding-cream/80 border border-wedding-gold/20 rounded-2xl p-8">
        <blockquote class="font-body italic text-gray-600 text-lg leading-relaxed mb-4">
          "Y sobre todas estas cosas vestíos de amor, que es el vínculo perfecto."
        </blockquote>
        <footer class="text-sm not-italic text-wedding-gold uppercase tracking-wider">
          — Colosenses 3:14
        </footer>
      </div>

      <p class="mt-10 text-gray-500 text-sm">
        Si recibiste tu invitación personalizada, usa el link que te fue compartido para confirmar tu asistencia.
      </p>
    </section>

    <!-- Footer -->
    <footer class="text-center py-8 border-t border-wedding-gold/10">
      <p class="text-xs text-gray-400">Con amor, Cesia & Luis 💍</p>
    </footer>
  </main>
</Layout>

<style>
  h1, h2.script-font {
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.05);
  }
</style>
