---
import Layout from "../../layouts/Layout.astro";
import { getGuest } from "../../lib/db";
import Countdown from "../../components/Countdown.astro";
import DressCode from "../../components/DressCode.astro";
import Gallery from "../../components/Gallery.astro";
import Gifts from "../../components/Gifts.astro";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/");
}

const guest = await getGuest(slug);

if (!guest || !guest.activo) {
  return Astro.redirect("/");
}
---

<Layout title={`Invitación de Boda — ${guest.personas.join(" & ")}`}>
  <!-- Splash / Cover Screen — Sobre de invitación -->
  <div id="splash-cover" class="fixed inset-0 z-[9999] flex items-center justify-center bg-wedding-cream transition-all duration-700">

    <!-- Partículas decorativas de fondo -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="splash-particle splash-particle-1"></div>
      <div class="splash-particle splash-particle-2"></div>
      <div class="splash-particle splash-particle-3"></div>
      <div class="splash-particle splash-particle-4"></div>
    </div>

    <div class="splash-content relative z-10 w-full text-center px-6">

      <!-- Encabezado -->
      <p class="cover-eyebrow text-[10px] md:text-xs uppercase tracking-[0.35em] text-wedding-sage font-serif-elegant">
        Nuestra Boda
      </p>

      <!-- Sobre -->
      <div class="envelope-scene">
        <div class="envelope" id="envelope">

          <!-- Cuerpo trasero -->
          <div class="env-back"></div>

          <!-- Carta interior -->
          <div class="env-letter" id="env-letter">
            <div class="env-letter-inner">
              <span class="env-letter-mono font-serif-elegant">C <i>&amp;</i> L</span>
              <span class="env-letter-rule"></span>
              <span class="env-letter-date">20 · 02 · 2027</span>
            </div>
          </div>

          <!-- Solapa superior -->
          <div class="env-flap"></div>

          <!-- Frente del sobre -->
          <div class="env-front">
            <span class="env-face env-face-left"></span>
            <span class="env-face env-face-right"></span>
            <span class="env-face env-face-bottom"></span>
          </div>

          <!-- Sello de lacre = botón de entrada -->
          <button id="enter-btn" class="env-seal" type="button" aria-label="Abrir invitación">
            <span class="env-seal-halo"></span>
            <span class="env-seal-halo env-seal-halo-2"></span>
            <span class="env-seal-body">
              <span class="env-seal-mono font-serif-elegant">C<i>&amp;</i>L</span>
            </span>
          </button>

        </div>
        <div class="envelope-shadow"></div>
      </div>

      <!-- Pie -->
      <div class="cover-footer">
        <p class="cover-names script-font">Cesia &amp; Luis</p>
        <div class="cover-rule"></div>
        <p class="cover-date">20 · Febrero · 2027</p>
        <p class="cover-hint">Toca el sello para abrir</p>
      </div>

    </div>
  </div>

  <!-- Transición final: la carta se despliega hasta ocupar la pantalla -->
  <div id="reveal-wash" aria-hidden="true"></div>

  <main id="invitation-content" class="relative max-w-4xl mx-auto bg-white shadow-2xl overflow-hidden">
    
    <!-- Hero -->
    <header class="text-center pt-20 pb-12 relative z-10 px-4" data-animate="fade-down">
      <!-- <p class="text-sm uppercase tracking-[0.3em] text-wedding-sage mb-4 font-serif-elegant">
        Están cordialmente invitados
      </p> -->
      <h1 class="font-serif-elegant text-5xl md:text-7xl text-wedding-dark-green mb-6 tracking-widest">
        C <span class="text-wedding-sage">&</span> L
      </h1>
      <blockquote class="font-body italic text-gray-600 max-w-md mx-auto text-lg leading-relaxed">
        "Y sobre todas estas cosas vestíos de amor, que es el vínculo perfecto."
        <footer class="text-sm mt-2 not-italic text-wedding-gold uppercase tracking-wider">
          — Colosenses 3:14
        </footer>
      </blockquote>
    </header>

    <!-- Hero Image -->
    <div class="relative h-[60vh] md:h-[75vh] w-full overflow-hidden" data-animate="fade-in">
      <div class="absolute inset-0 bg-gradient-to-b from-white/80 via-transparent to-transparent z-10"></div>
      <picture>
        <source media="(max-width: 640px)" srcset="/images/optimos/_DSC3356-mobile.webp" />
        <img
          src="/images/optimos/_DSC3356.webp"
          alt="Cesia y Luis"
          class="w-full h-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-white/90 via-transparent to-transparent z-10"></div>
    </div>

    <!-- Invitado personalizado -->
    <section class="text-center -mt-24 relative z-30 pb-12 px-4" data-animate="fade-up">
      <div class="mb-6 text-sm font-serif-elegant text-gray-500 uppercase tracking-widest">
        <p>Con la bendición de Dios y de nuestros padres</p>
        <div class="flex justify-between max-w-xs mx-auto mt-4 text-xs md:text-sm leading-loose">
          <div>
            <p>Wendy Bonilla</p>
            <p>Jorge Mejía</p>
          </div>
          <div>
            <p>Jesica Guerrero</p>
            <p>Oscar Bonilla</p>
          </div>
        </div>
      </div>

      <h2 class="script-font text-6xl md:text-8xl text-wedding-dark-green mb-6 relative inline-block">
        Cesia <span class="text-4xl md:text-6xl text-wedding-sage align-middle">&</span> Luis
      </h2>
      <p class="text-xl font-body italic text-gray-600 mb-10">
        Tienen el placer de invitarle a su enlace matrimonial
      </p>

      <!-- Nombre del invitado -->
      <div class="bg-wedding-cream/80 border border-wedding-gold/30 rounded-2xl py-6 px-8 mb-10 inline-block" data-animate="scale-in">
        <p class="text-sm uppercase tracking-widest text-wedding-sage mb-2 font-serif-elegant">Invitación para</p>
        <p class="script-font text-4xl md:text-5xl text-wedding-dark-green">
          {guest.personas.join(" & ")}
        </p>
        <p class="text-sm text-gray-500 mt-2">
          {guest.personas.length === 1 ? "1 persona" : `${guest.personas.length} personas`}
        </p>
      </div>

      <!-- Fecha y lugar -->
      <div class="inline-block border-y-2 border-wedding-gold/50 py-6 px-10 mb-12 w-full max-w-lg" data-animate="fade-up">
        <p class="font-serif-elegant text-2xl md:text-4xl text-wedding-dark-green uppercase tracking-widest mb-2">
          20 de Febrero de 2027
        </p>
        <p class="font-serif-elegant text-lg md:text-xl text-gray-700 uppercase tracking-wider">
          Sábado, a las 16:00 H
        </p>
      </div>

      <div class="font-body text-lg text-gray-700 leading-relaxed" data-animate="fade-up">
        <p class="font-bold text-wedding-dark-green uppercase tracking-wider mb-1">
          Casa Venuat
        </p>
        <p>Valle de Ángeles</p>
        <p>Francisco Morazán, Honduras</p>
      </div>
    </section>

    <Countdown />

    <!-- Imagen separador -->
    <div class="py-8 relative overflow-hidden" data-animate="fade-in">
      <div class="absolute inset-0 bg-gradient-to-b from-white/90 via-transparent to-transparent z-10"></div>
      <picture>
        <source media="(max-width: 640px)" srcset="/images/optimos/_DSC3214-mobile.webp" />
        <img
          src="/images/optimos/_DSC3214.webp"
          alt="Pareja sonriendo"
          class="w-full h-80 md:h-96 object-cover object-center"
          loading="lazy"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-white/90 via-transparent to-transparent z-10"></div>
    </div>

    <!-- Acceso rápido -->
    <section class="py-12 text-center px-4" data-animate="fade-up">
      <p class="text-sm uppercase tracking-widest text-gray-500 mb-8 font-serif-elegant">
        Acceso Rápido
      </p>
      <div class="grid grid-cols-3 gap-6 max-w-sm mx-auto">
        <a
          href="https://maps.app.goo.gl/G2zTu4DMBkfSS5mo8"
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center group"
        >
          <div class="w-14 h-14 md:w-16 md:h-16 bg-wedding-dark-green rounded-full flex items-center justify-center text-white shadow-lg group-hover:bg-wedding-gold group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <span class="mt-3 text-xs uppercase tracking-wider font-serif-elegant">Ubicación</span>
        </a>
        <a href="#rsvp" class="flex flex-col items-center group">
          <div class="w-14 h-14 md:w-16 md:h-16 bg-wedding-dark-green rounded-full flex items-center justify-center text-white shadow-lg group-hover:bg-wedding-gold group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="mt-3 text-xs uppercase tracking-wider font-serif-elegant">Confirmar</span>
        </a>
        <a href="#gifts" class="flex flex-col items-center group">
          <div class="w-14 h-14 md:w-16 md:h-16 bg-wedding-dark-green rounded-full flex items-center justify-center text-white shadow-lg group-hover:bg-wedding-gold group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
            </svg>
          </div>
          <span class="mt-3 text-xs uppercase tracking-wider font-serif-elegant">Regalos</span>
        </a>
      </div>
    </section>

    <DressCode />

    <!-- Sección Solo Adultos -->
    <section class="py-12 px-4" data-animate="fade-up">
      <div class="max-w-2xl mx-auto bg-amber-50/60 border border-amber-200/50 rounded-2xl p-8 text-center">
        <div class="w-12 h-12 mx-auto mb-4 bg-amber-100 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h3 class="font-serif-elegant text-xl text-amber-900 mb-3">Evento exclusivo para adultos</h3>
        <p class="text-amber-800/80 text-sm leading-relaxed max-w-md mx-auto">
          Con todo el cariño, les pedimos que este día sea solo para adultos.
          Agradecemos de corazón su comprensión.
        </p>
      </div>
    </section>

    <!-- Sección Sin Alcohol -->
    <section class="py-6 px-4" data-animate="fade-up">
      <div class="max-w-2xl mx-auto bg-rose-50/60 border border-rose-200/50 rounded-2xl p-8 text-center">
        <div class="w-12 h-12 mx-auto mb-4 bg-rose-100 rounded-full flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-rose-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        </div>
        <h3 class="font-serif-elegant text-xl text-rose-900 mb-3">Celebración libre de alcohol</h3>
        <p class="text-rose-800/80 text-sm leading-relaxed max-w-md mx-auto">
          Hemos decidido que nuestra celebración sea libre de bebidas alcohólicas.
          Les pedimos amablemente no llevar alcohol por separado.
          Cualquier incumplimiento generará un cargo por los gastos que esto conlleve.
          <span class="block mt-2 italic">Agradecemos su respeto a nuestra decisión. 🤍</span>
        </p>
      </div>
    </section>

    <!-- Decorativo animado: hojas cayendo -->
    <div class="deco-section relative py-6 overflow-hidden">
      <div class="deco-leaves">
        <svg class="deco-leaf deco-leaf-1" viewBox="0 0 30 50" fill="none">
          <path d="M15 0 C5 10 0 25 5 40 C10 50 20 50 25 40 C30 25 25 10 15 0Z" fill="currentColor"/>
        </svg>
        <svg class="deco-leaf deco-leaf-2" viewBox="0 0 30 50" fill="none">
          <path d="M15 0 C5 10 0 25 5 40 C10 50 20 50 25 40 C30 25 25 10 15 0Z" fill="currentColor"/>
        </svg>
        <svg class="deco-leaf deco-leaf-3" viewBox="0 0 30 50" fill="none">
          <path d="M15 0 C5 10 0 25 5 40 C10 50 20 50 25 40 C30 25 25 10 15 0Z" fill="currentColor"/>
        </svg>
      </div>
      <div class="flex justify-center items-center gap-3">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-wedding-gold/30"></div>
        <div class="deco-diamond"></div>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-wedding-gold/30"></div>
      </div>
    </div>

    <Gallery />

    <!-- Decorativo animado: ondas doradas -->
    <div class="deco-section relative py-8 overflow-hidden">
      <div class="deco-sparkles">
        <div class="deco-sparkle deco-sparkle-1"></div>
        <div class="deco-sparkle deco-sparkle-2"></div>
        <div class="deco-sparkle deco-sparkle-3"></div>
        <div class="deco-sparkle deco-sparkle-4"></div>
        <div class="deco-sparkle deco-sparkle-5"></div>
      </div>
      <div class="flex justify-center items-center gap-3">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-wedding-sage/30"></div>
        <svg class="w-5 h-5 text-wedding-sage/40 deco-rotate" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L15 9H22L16 14L18 21L12 17L6 21L8 14L2 9H9L12 2Z"/>
        </svg>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-wedding-sage/30"></div>
      </div>
    </div>

    <Gifts />

    <!-- Decorativo animado: ramas flotantes -->
    <div class="deco-section relative py-8 overflow-hidden">
      <div class="deco-branches">
        <svg class="deco-branch deco-branch-left" viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M0,20 Q20,10 40,20 Q60,30 80,20"/>
          <path d="M20,15 Q15,8 10,10"/><path d="M40,20 Q35,12 30,14"/>
          <path d="M60,25 Q55,18 50,20"/>
        </svg>
        <svg class="deco-branch deco-branch-right" viewBox="0 0 80 40" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M0,20 Q20,30 40,20 Q60,10 80,20"/>
          <path d="M20,25 Q15,32 10,30"/><path d="M40,20 Q35,28 30,26"/>
          <path d="M60,15 Q55,22 50,20"/>
        </svg>
      </div>
      <div class="flex justify-center items-center gap-3">
        <div class="h-px w-10 bg-gradient-to-r from-transparent to-wedding-gold/30"></div>
        <div class="deco-diamond"></div>
        <div class="deco-diamond deco-diamond-sm"></div>
        <div class="deco-diamond"></div>
        <div class="h-px w-10 bg-gradient-to-l from-transparent to-wedding-gold/30"></div>
      </div>
    </div>

    <!-- RSVP Section -->
    <section id="rsvp" class="py-20 px-4 relative" data-animate="fade-up">
      <div class="max-w-xl mx-auto bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-wedding-sage/30 relative z-10">
        {guest.confirmado ? (
          <!-- Ya confirmó -->
          <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-6 bg-green-100 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h2 class="script-font text-4xl text-wedding-dark-green mb-4">¡Ya confirmaste!</h2>
            <p class="text-gray-600 mb-2">
              {guest.cantidadConfirmada === 0
                ? "Lamentamos que no puedas asistir."
                : `Confirmaste asistencia para ${guest.cantidadConfirmada} ${guest.cantidadConfirmada === 1 ? "persona" : "personas"}.`
              }
            </p>
            {guest.mensaje && (
              <p class="text-sm italic text-gray-400 mt-4">"{guest.mensaje}"</p>
            )}
            <p class="text-xs text-gray-400 mt-4">
              Confirmado el {new Date(guest.fechaConfirmacion!).toLocaleDateString("es-HN", { day: "numeric", month: "long", year: "numeric" })}
            </p>
          </div>
        ) : (
          <!-- Formulario de confirmación -->
          <div>
            <h2 class="script-font text-5xl text-center mb-2 text-wedding-dark-green">
              Confirma tu asistencia
            </h2>
            <p class="text-center text-gray-600 mb-8">
              Por favor, confirma antes del <strong>20 de Enero de 2027</strong>.
            </p>

            <form id="rsvp-form" class="space-y-6">
              <input type="hidden" name="slug" value={slug} />

              <div class="bg-wedding-cream/50 rounded-xl p-4 text-center">
                <p class="text-sm text-gray-500">Invitación para</p>
                <p class="font-serif-elegant text-lg text-wedding-dark-green">
                  {guest.personas.join(" & ")}
                </p>
              </div>

              <div>
                <label class="block text-sm font-serif-elegant text-wedding-dark-green mb-3">
                  ¿Asistirás?
                </label>
                <div class="flex items-center gap-4">
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="asistencia" value="si" class="peer hidden" checked />
                    <div class="peer-checked:bg-wedding-dark-green peer-checked:text-white peer-checked:border-wedding-dark-green border-2 border-gray-200 rounded-xl py-3 px-4 text-center transition-all duration-200 hover:border-wedding-sage">
                      <span class="text-sm font-medium">¡Sí, confirmo! 🎉</span>
                    </div>
                  </label>
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="asistencia" value="no" class="peer hidden" />
                    <div class="peer-checked:bg-gray-700 peer-checked:text-white peer-checked:border-gray-700 border-2 border-gray-200 rounded-xl py-3 px-4 text-center transition-all duration-200 hover:border-gray-400">
                      <span class="text-sm font-medium">No podré asistir</span>
                    </div>
                  </label>
                </div>
              </div>

              <div id="cantidad-section">
                {guest.personas.length === 2 ? (
                  <!-- Pareja: fijo en 2 -->
                  <div class="mt-1 flex items-center gap-2 py-3 px-4 bg-wedding-cream/50 rounded-xl border border-wedding-sage/30">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-wedding-sage" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 7a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                    <span class="text-sm text-wedding-dark-green font-medium">2 personas</span>
                  </div>
                  <input type="hidden" name="cantidad" value="2" />
                ) : (
                  <!-- Individual: fijo en 1 -->
                  <input type="hidden" name="cantidad" value="1" />
                )}
              </div>

              <div>
                <label for="mensaje" class="block text-sm font-serif-elegant text-wedding-dark-green mb-1">
                  Mensaje para los novios <span class="text-gray-400">(opcional)</span>
                </label>
                <textarea
                  id="mensaje"
                  name="mensaje"
                  rows="3"
                  maxlength="500"
                  class="mt-1 block w-full rounded-xl border-wedding-sage/50 shadow-sm focus:border-wedding-gold focus:ring focus:ring-wedding-gold/50 bg-wedding-cream/50 py-3 px-4"
                  placeholder="Escribe unas palabras..."
                ></textarea>
              </div>

              <div class="text-center pt-4">
                <button
                  type="submit"
                  id="submit-btn"
                  class="inline-flex items-center justify-center py-3 px-10 border border-transparent shadow-lg text-lg font-serif-elegant rounded-full text-white bg-wedding-dark-green hover:bg-wedding-gold transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-wedding-gold uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  Enviar Confirmación
                </button>
              </div>

              <!-- Feedback -->
              <div id="form-feedback" class="hidden text-center p-4 rounded-xl"></div>
            </form>
          </div>
        )}
      </div>
    </section>

    <!-- Footer -->
    <footer class="text-center pt-16 pb-4 relative" data-animate="fade-up">
      <h2 class="script-font text-5xl md:text-6xl text-wedding-dark-green mb-8 relative z-20">
        ¡Los esperamos!
      </h2>
      <div class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-white/90 via-transparent to-transparent z-10"></div>
        <picture>
          <source media="(max-width: 640px)" srcset="/images/optimos/_DSC3201-mobile.webp" />
          <img
            src="/images/optimos/_DSC3201.webp"
            alt="Cesia y Luis"
            class="w-full h-72 md:h-96 object-cover object-center"
            loading="lazy"
          />
        </picture>
      </div>
      <p class="text-xs text-gray-400 mt-8 pb-4">Con amor, Cesia & Luis 💍</p>
    </footer>
  </main>

  <!-- Lightbox: fuera del main para evitar overflow-hidden -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-label="Galería de fotos">
    <button id="lightbox-close" class="lightbox-close" aria-label="Cerrar galería">
