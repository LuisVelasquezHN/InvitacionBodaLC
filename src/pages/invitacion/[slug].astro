<script>
  function initRSVP() {
    const form = document.getElementById("rsvp-form") as HTMLFormElement | null;
    if (!form) return;

    const cantidadSection = document.getElementById("cantidad-section");
    const radios = form.querySelectorAll<HTMLInputElement>('input[name="asistencia"]');
    const feedback = document.getElementById("form-feedback");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

    // Toggle cantidad section
    radios.forEach((radio) => {
      radio.addEventListener("change", () => {
        if (cantidadSection) {
          cantidadSection.style.display = radio.value === "si" ? "block" : "none";
        }
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const slug = formData.get("slug") as string;
      const asistencia = formData.get("asistencia") as string;
      const cantidad = formData.get("cantidad") as string;
      const mensaje = formData.get("mensaje") as string;

      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";

      try {
        const res = await fetch("/api/rsvp", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug, asistencia, cantidad, mensaje }),
        });

        const data = await res.json();

        if (feedback) {
          feedback.classList.remove("hidden");
          if (res.ok) {
            feedback.className = "text-center p-4 rounded-xl bg-green-50 text-green-800 border border-green-200";
            feedback.innerHTML = `<p class="font-medium">${data.message}</p>`;
            form.querySelectorAll("input, select, textarea, button").forEach((el) => {
              (el as HTMLInputElement).disabled = true;
            });
            // Reload after 2s to show confirmed state
            setTimeout(() => window.location.reload(), 2000);
          } else {
            feedback.className = "text-center p-4 rounded-xl bg-red-50 text-red-800 border border-red-200";
            feedback.innerHTML = `<p class="font-medium">${data.error}</p>`;
            submitBtn.disabled = false;
            submitBtn.textContent = "Enviar Confirmación";
          }
        }
      } catch {
        if (feedback) {
          feedback.classList.remove("hidden");
          feedback.className = "text-center p-4 rounded-xl bg-red-50 text-red-800 border border-red-200";
          feedback.innerHTML = `<p class="font-medium">Error de conexión. Inténtalo de nuevo.</p>`;
        }
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar Confirmación";
      }
    });
  }

  document.addEventListener("DOMContentLoaded", initRSVP);
  document.addEventListener("astro:page-load", initRSVP);
</script>

<script>
  // Portada: sobre que se abre al tocar el sello
  function initSplash() {
    const splash = document.getElementById("splash-cover");
    const content = document.getElementById("invitation-content");
    const enterBtn = document.getElementById("enter-btn");
    const envelope = document.getElementById("envelope");
    const letter = document.getElementById("env-letter");
    const wash = document.getElementById("reveal-wash");

    if (!splash || !content || !enterBtn || !envelope || !letter || !wash) return;

    // Bloquear scroll mientras la portada está visible
    document.body.style.overflow = "hidden";

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let opened = false;
    const timers = [];
    const at = (ms, fn) => timers.push(window.setTimeout(fn, ms));

    function revealContent() {
      content.classList.add("content-visible");
      document.body.style.overflow = "";
      window.scrollTo(0, 0);

      setTimeout(() => {
        content.querySelectorAll("[data-animate]").forEach((el, i) => {
          if (i < 4) setTimeout(() => el.classList.add("is-visible"), i * 150);
        });
      }, 200);
    }

    function expandLetter() {
      const r = letter.getBoundingClientRect();
      const top = Math.max(0, r.top);
      const left = Math.max(0, r.left);
      const right = Math.max(0, window.innerWidth - r.right);
      const bottom = Math.max(0, window.innerHeight - r.bottom);

      wash.style.clipPath = `inset(${top}px ${right}px ${bottom}px ${left}px round 6px)`;
      wash.style.opacity = "1";

      requestAnimationFrame(() => {
        wash.classList.add("is-active");
        requestAnimationFrame(() => {
          wash.style.clipPath = "inset(0px 0px 0px 0px round 0px)";
        });
      });
    }

    function openEnvelope() {
      if (opened) return;
      opened = true;
      enterBtn.disabled = true;
      splash.classList.add("is-opening");

      if (reduced) {
        splash.classList.add("splash-exit");
        revealContent();
        at(700, () => { splash.remove(); wash.remove(); });
        return;
      }

      // Encadenamos por transitionend (con respaldo por tiempo) para que
      // cada paso arranque cuando el anterior terminó de verdad, aunque el
      // navegador haya pausado las animaciones (pestaña en segundo plano).
      const then = (el, fallbackMs, fn) => {
        let done = false;
        const run = () => {
          if (done) return;
          done = true;
          el.removeEventListener("transitionend", onEnd);
          fn();
        };
        const onEnd = (e) => { if (e.target === el && e.propertyName === "transform") run(); };
        el.addEventListener("transitionend", onEnd);
        at(fallbackMs, run);
      };

      const flap = envelope.querySelector(".env-flap");

      // 1 · el lacre se rompe  →  2 · la solapa se abre
      at(320, () => {
        envelope.classList.add("is-open");
        // 3 · la carta sale del sobre
        then(flap, 1400, () => {
          envelope.classList.add("is-letter-out");
          // 4 · la carta se despliega hasta llenar la pantalla
          then(letter, 1400, () => {
            expandLetter();
            // 5 · detrás del velo, la invitación ya está lista
            at(750, () => { splash.classList.add("splash-exit"); revealContent(); });
            // 6 · se disuelve el velo
            at(950, () => wash.classList.add("is-fading"));
            at(1800, () => { splash.remove(); wash.remove(); });
          });
        });
      });
    }

    enterBtn.addEventListener("click", openEnvelope);

    // Limpieza en navegaciones de Astro
    document.addEventListener("astro:before-swap", () => timers.forEach(clearTimeout), { once: true });
  }

  document.addEventListener("DOMContentLoaded", initSplash);
  document.addEventListener("astro:page-load", initSplash);
</script>

<style>
  h1, h2.script-font {
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.05);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: white;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 10;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: white;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 10;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 0.5rem;
    transition: opacity 0.3s ease;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  /* ============================================
     PORTADA — SOBRE DE INVITACIÓN
     ============================================ */
  #splash-cover {
    background:
      radial-gradient(ellipse at 20% 30%, rgba(143, 158, 139, 0.10) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 70%, rgba(191, 163, 124, 0.10) 0%, transparent 55%),
      var(--color-wedding-cream);
  }

  .splash-content {
    animation: splash-fade-in 1s ease-out both;
  }

  .cover-eyebrow {
    animation: splash-fade-in 0.9s ease-out 0.15s backwards;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  /* --- Escena 3D --- */
  .envelope-scene {
    --env-w: min(84vw, 380px);
    --env-h: calc(var(--env-w) * 0.66);
    --paper: #fbf8f1;
    --paper-2: #f2ece0;
    --paper-3: #e9e1d1;
    --lining: #e7ebe4;

    position: relative;
    width: var(--env-w);
    height: var(--env-h);
    margin: clamp(1.75rem, 6vw, 2.75rem) auto clamp(1.25rem, 4vw, 2rem);
    perspective: 1300px;
    perspective-origin: 50% 0%;
  }

  @media (min-width: 768px) {
    .envelope-scene {
      --env-w: min(58vw, 460px);
    }
  }

  .envelope {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(4deg);
    transition: transform 1s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.6s ease;
    animation: envelope-in 1.1s cubic-bezier(0.2, 0.8, 0.3, 1) 0.25s backwards;
  }

  @keyframes envelope-in {
    from { opacity: 0; transform: rotateX(18deg) translateY(28px) scale(0.94); }
    to   { opacity: 1; transform: rotateX(4deg) translateY(0) scale(1); }
  }

  .envelope-shadow {
    position: absolute;
    left: 50%;
    bottom: -14px;
    width: 78%;
    height: 18px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(74, 93, 70, 0.22) 0%, transparent 70%);
    filter: blur(5px);
    animation: splash-fade-in 1s ease-out 0.6s backwards;
    transition: opacity 0.6s ease, transform 0.8s ease;
  }

  /* --- Cuerpo del sobre --- */
  .env-back {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 6px;
    background: linear-gradient(160deg, var(--paper) 0%, var(--paper-2) 100%);
    box-shadow:
      0 18px 40px -12px rgba(74, 93, 70, 0.28),
      0 2px 6px rgba(74, 93, 70, 0.10),
      inset 0 0 0 1px rgba(191, 163, 124, 0.28);
  }

  /* --- Carta interior --- */
  .env-letter {
    position: absolute;
    left: 6%;
    top: 7%;
    width: 88%;
    height: 86%;
    z-index: 2;
    border-radius: 4px;
    background: linear-gradient(175deg, #ffffff 0%, #fdfbf6 100%);
    box-shadow:
      0 -2px 14px rgba(74, 93, 70, 0.12),
      inset 0 0 0 1px rgba(191, 163, 124, 0.35);
    transform: translateY(0);
    transition: transform 1.05s cubic-bezier(0.45, 0, 0.15, 1);
  }

  .env-letter-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 62%;
    padding-top: 6%;
  }

  .env-letter-mono {
    font-size: clamp(1.5rem, 6vw, 2rem);
    letter-spacing: 0.18em;
    color: var(--color-wedding-dark-green);
  }

  .env-letter-mono i {
    font-style: normal;
    color: var(--color-wedding-gold);
  }

  .env-letter-rule {
    width: 38px;
    height: 1px;
    background: rgba(191, 163, 124, 0.7);
  }

  .env-letter-date {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-wedding-sage);
  }

  /* --- Solapa superior --- */
  .env-flap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 58%;
    z-index: 4;
    transform-origin: top center;
    transform: rotateX(0deg);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    background: linear-gradient(170deg, var(--paper) 0%, var(--paper-3) 100%);
    filter: drop-shadow(0 3px 4px rgba(74, 93, 70, 0.14));
    transition:
      transform 1.05s cubic-bezier(0.55, 0, 0.25, 1),
      background 0.6s ease 0.35s,
      z-index 0s linear 0.42s;
    backface-visibility: visible;
  }

  /* --- Frente del sobre --- */
  .env-front {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }

  .env-face {
    position: absolute;
    inset: 0;
    display: block;
  }

  .env-face-left {
    clip-path: polygon(0 0, 50% 50%, 50% 100%, 0 100%);
    background: linear-gradient(100deg, var(--paper) 0%, var(--paper-2) 100%);
  }

  .env-face-right {
    clip-path: polygon(100% 0, 50% 50%, 50% 100%, 100% 100%);
    background: linear-gradient(260deg, var(--paper) 0%, var(--paper-3) 100%);
  }

  .env-face-bottom {
    clip-path: polygon(0 100%, 50% 42%, 100% 100%);
    background: linear-gradient(0deg, var(--paper-2) 0%, var(--paper) 100%);
    filter: drop-shadow(0 -2px 3px rgba(74, 93, 70, 0.10));
  }

  .env-front::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px rgba(191, 163, 124, 0.30);
  }

  /* --- Sello de lacre (botón) --- */
  .env-seal {
    position: absolute;
    top: 47%;
    left: 50%;
    z-index: 6;
    width: clamp(66px, 20vw, 86px);
    height: clamp(66px, 20vw, 86px);
    transform: translate(-50%, -50%);
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    animation: seal-appear 0.8s ease-out 1.1s backwards;
    transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
  }

  .env-seal:hover { transform: translate(-50%, -50%) scale(1.06); }
  .env-seal:active { transform: translate(-50%, -50%) scale(0.94); }

  .env-seal:focus-visible {
    outline: 2px solid var(--color-wedding-gold);
    outline-offset: 6px;
    border-radius: 50%;
  }

  .env-seal-body {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* borde ligeramente irregular: cera, no botón */
    border-radius: 47% 53% 51% 49% / 52% 48% 53% 47%;
    background:
      radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.38) 0%, transparent 48%),
      radial-gradient(circle at 72% 82%, rgba(0, 0, 0, 0.22) 0%, transparent 55%),
      linear-gradient(145deg, #5f7459 0%, var(--color-wedding-dark-green) 45%, #38472f 100%);
    box-shadow:
      0 8px 18px -5px rgba(59, 75, 56, 0.55),
      0 2px 4px rgba(59, 75, 56, 0.25),
      inset 0 -3px 6px rgba(0, 0, 0, 0.30),
      inset 0 2px 4px rgba(255, 255, 255, 0.20);
    animation: seal-breathe 3s ease-in-out 1.9s infinite;
    overflow: hidden;
  }

  /* anillo grabado interior del sello */
  .env-seal-body::before {
    content: "";
    position: absolute;
    inset: 13%;
    border-radius: inherit;
    border: 1px solid rgba(232, 220, 200, 0.35);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  /* Brillo que recorre el sello */
  .env-seal-body::after {
    content: "";
    position: absolute;
    top: -60%;
    left: -120%;
    width: 60%;
    height: 220%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.32), transparent);
    transform: rotate(18deg);
    animation: seal-shine 4.5s ease-in-out 2.4s infinite;
  }

  .env-seal-mono {
    position: relative;
    z-index: 2;
    font-size: clamp(0.85rem, 3.4vw, 1.05rem);
    letter-spacing: 0.06em;
    color: #f6f1e6;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }

  .env-seal-mono i {
    font-style: normal;
    color: var(--color-wedding-light-gold);
    margin: 0 1px;
  }

  /* Halos que laten alrededor del sello */
  .env-seal-halo {
    position: absolute;
    inset: 0;
    border-radius: 47% 53% 51% 49% / 52% 48% 53% 47%;
    border: 1px solid rgba(191, 163, 124, 0.55);
    opacity: 0;
    pointer-events: none;
    animation: seal-halo 3.2s ease-out 2.2s infinite;
  }

  .env-seal-halo-2 {
    animation-delay: 3.4s;
  }

  @keyframes seal-appear {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes seal-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.045); }
  }

  @keyframes seal-shine {
    0%, 55% { left: -120%; }
    85%, 100% { left: 160%; }
  }

  @keyframes seal-halo {
    0% { opacity: 0.75; transform: scale(1); }
    70% { opacity: 0; transform: scale(1.9); }
    100% { opacity: 0; transform: scale(1.9); }
  }

  /* --- Pie de portada --- */
  .cover-footer {
    animation: splash-fade-in 0.9s ease-out 0.9s backwards;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }

  .cover-names {
    font-size: clamp(2.25rem, 11vw, 3.25rem);
    line-height: 1.1;
    color: var(--color-wedding-dark-green);
  }

  .cover-rule {
    width: 54px;
    height: 1px;
    margin: 0.65rem auto;
    background: linear-gradient(90deg, transparent, rgba(191, 163, 124, 0.85), transparent);
  }

  .cover-date {
    font-family: var(--font-serif-elegant);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-wedding-sage);
  }

  .cover-hint {
    margin-top: 1.1rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #9ca3af;
    animation: bounce-subtle 2.4s ease-in-out 2s infinite;
  }

  @keyframes bounce-subtle {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  @keyframes splash-fade-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ============================================
     APERTURA
     ============================================ */

  /* 1 · el lacre se rompe y se desprende */
  #splash-cover.is-opening .env-seal {
    pointer-events: none;
    animation: seal-break 0.75s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  #splash-cover.is-opening .env-seal-body,
  #splash-cover.is-opening .env-seal-body::after,
  #splash-cover.is-opening .env-seal-halo {
    animation: none;
  }

  @keyframes seal-break {
    0%   { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
    22%  { transform: translate(-50%, -50%) scale(0.88) rotate(-6deg); opacity: 1; }
    100% { transform: translate(-50%, -95%) scale(1.35) rotate(14deg); opacity: 0; }
  }

  /* 2 · la solapa se abre hacia atrás */
  .envelope.is-open .env-flap {
    transform: rotateX(180deg);
    z-index: 1;
    background: linear-gradient(170deg, var(--lining) 0%, #dfe5db 100%);
    filter: drop-shadow(0 -4px 6px rgba(74, 93, 70, 0.10));
  }

  /* 3 · la carta sale del sobre */
  .envelope.is-letter-out {
    transform: rotateX(0deg) translateY(6%);
  }

  .envelope.is-letter-out .env-letter {
    transform: translateY(-80%) scale(1.02);
    box-shadow:
      0 22px 40px -18px rgba(74, 93, 70, 0.45),
      inset 0 0 0 1px rgba(191, 163, 124, 0.35);
  }

  /* 4 · texto de portada se desvanece */
  #splash-cover.is-opening .cover-footer,
  #splash-cover.is-opening .cover-eyebrow {
    opacity: 0;
    transform: translateY(10px);
  }

  #splash-cover.is-opening .envelope-shadow {
    opacity: 0;
  }

  /* 5 · salida del splash */
  #splash-cover.splash-exit {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  /* 6 · la carta se despliega hasta llenar la pantalla */
  #reveal-wash {
    position: fixed;
    inset: 0;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(175deg, #ffffff 0%, #fdfbf6 100%);
    clip-path: inset(50% 50% 50% 50% round 12px);
  }

  #reveal-wash.is-active {
