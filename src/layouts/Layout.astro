---
interface Props {
  title?: string;
}

const { title = "Boda Cesia & Luis — 20 de Febrero 2027" } = Astro.props;
const description = "Celebramos nuestro amor. Acompáñanos el 20 de febrero de 2027 en Casa Venuat, Valle de Ángeles, Honduras.";
const ogImage = "/images/optimos/_DSC3356.webp";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Fonts: preload para evitar FOIT -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Great+Vibes&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" 
      rel="stylesheet" 
    />

    <title>{title}</title>
  </head>
  <body class="bg-wedding-cream font-body antialiased overflow-x-hidden">
    <slot />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  @theme {
    --font-serif-elegant: "Cinzel Decorative", serif;
    --font-script: "Great Vibes", cursive;
    --font-body: "Lora", serif;

    --color-wedding-sage: #8f9e8b;
    --color-wedding-dark-green: #4a5d46;
    --color-wedding-cream: #f9f7f1;
    --color-wedding-gold: #bfa37c;
    --color-wedding-light-gold: #e8dcc8;
  }

  /* Typography */
  h1, h2, h3 {
    font-family: var(--font-serif-elegant);
    color: var(--color-wedding-dark-green);
  }

  .script-font {
    font-family: var(--font-script);
    color: var(--color-wedding-dark-green);
  }

  /* Scroll Animations */
  [data-animate] {
    opacity: 0;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  [data-animate="fade-up"] {
    transform: translateY(40px);
  }

  [data-animate="fade-down"] {
    transform: translateY(-40px);
  }

  [data-animate="fade-in"] {
    transform: scale(0.98);
  }

  [data-animate="scale-in"] {
    transform: scale(0.9);
  }

  [data-animate="fade-left"] {
    transform: translateX(-40px);
  }

  [data-animate="fade-right"] {
    transform: translateX(40px);
  }

  [data-animate].is-visible {
    opacity: 1;
    transform: translateY(0) translateX(0) scale(1);
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-wedding-cream);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-wedding-sage);
    border-radius: 3px;
  }

  /* Selection */
  ::selection {
    background: var(--color-wedding-light-gold);
    color: var(--color-wedding-dark-green);
  }
</style>

<script>
  // Intersection Observer for scroll animations
  function initAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      }
    );

    document.querySelectorAll("[data-animate]").forEach((el) => {
      observer.observe(el);
    });
  }

  document.addEventListener("DOMContentLoaded", initAnimations);
  document.addEventListener("astro:page-load", initAnimations);
</script>
