---

---

<section id="rsvp" class="py-20 px-4 relative">
    <div
        class="max-w-xl mx-auto bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-wedding-sage/30 relative z-10"
    >
        <h2
            class="script-font text-5xl text-center mb-2 text-wedding-dark-green"
        >
            Confirma tu asistencia
        </h2>
        <p class="text-center text-gray-600 mb-8">
            Por favor, confirma antes del 20 de Junio.
        </p>

        <div
            class="bg-wedding-gold/10 border-l-4 border-wedding-gold p-4 mb-8 text-center"
        >
            <p
                class="font-serif-elegant text-wedding-dark-green text-sm md:text-base"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6 inline-block mb-1 text-wedding-gold"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                </svg>
                Recepción exclusiva para adultos.
                <br /><span class="font-body italic text-sm"
                    >Agradecemos su comprensión.</span
                >
            </p>
        </div>

        <form action="ACTION_URL" method="POST" class="space-y-6">
            <div>
                <label
                    for="nombre"
                    class="block text-sm font-serif-elegant text-wedding-dark-green mb-1"
                    >Nombre Completo</label
                >
                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    required
                    class="mt-1 block w-full rounded-md border-wedding-sage/50 shadow-sm focus:border-wedding-gold focus:ring focus:ring-wedding-gold/50 bg-wedding-cream/50"
                    placeholder="Tu nombre y apellido"
                />
            </div>

            <div>
                <label
                    class="block text-sm font-serif-elegant text-wedding-dark-green mb-2"
                    >¿Asistirás?</label
                >
                <div class="flex items-center space-x-6">
                    <div class="flex items-center">
                        <input
                            id="si-asisto"
                            name="asistencia"
                            type="radio"
                            value="si"
                            checked
                            class="focus:ring-wedding-gold h-4 w-4 text-wedding-green border-gray-300"
                        />
                        <label
                            for="si-asisto"
                            class="ml-3 block text-sm font-medium text-gray-700"
                            >¡Sí, confirmo!</label
                        >
                    </div>
                    <div class="flex items-center">
                        <input
                            id="no-asisto"
                            name="asistencia"
                            type="radio"
                            value="no"
                            class="focus:ring-wedding-gold h-4 w-4 text-wedding-red border-gray-300"
                        />
                        <label
                            for="no-asisto"
                            class="ml-3 block text-sm font-medium text-gray-700"
                            >No podré asistir</label
                        >
                    </div>
                </div>
            </div>

            <div>
                <label
                    for="pases"
                    class="block text-sm font-serif-elegant text-wedding-dark-green mb-1"
                    >Número de Adultos</label
                >
                <select
                    id="pases"
                    name="pases"
                    class="mt-1 block w-full rounded-md border-wedding-sage/50 shadow-sm focus:border-wedding-gold focus:ring focus:ring-wedding-gold/50 bg-wedding-cream/50"
                >
                    <option>1 Adulto</option>
                    <option>2 Adultos</option>
                </select>
                <p class="text-xs text-gray-500 mt-1">
                    Máximo 2 adultos por invitación.
                </p>
            </div>

            <div>
                <label
                    for="mensaje"
                    class="block text-sm font-serif-elegant text-wedding-dark-green mb-1"
                    >Mensaje (Opcional)</label
                >
                <textarea
                    id="mensaje"
                    name="mensaje"
                    rows="3"
                    class="mt-1 block w-full rounded-md border-wedding-sage/50 shadow-sm focus:border-wedding-gold focus:ring focus:ring-wedding-gold/50 bg-wedding-cream/50"
                ></textarea>
            </div>

            <div class="text-center pt-4">
                <button
                    type="submit"
                    class="inline-flex justify-center py-3 px-10 border border-transparent shadow-sm text-lg font-serif-elegant rounded-full text-white bg-wedding-dark-green hover:bg-wedding-sage transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-wedding-gold uppercase tracking-widest"
                >
                    Enviar Confirmación
                </button>
            </div>
        </form>
    </div>
</section>
