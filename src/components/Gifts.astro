---

---

<section id="gifts" class="py-16 px-4" data-animate="fade-up">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="script-font text-5xl md:text-6xl mb-4 text-wedding-dark-green">Mesa de Regalos</h2>
    <p class="text-gray-600 mb-10 italic font-body text-sm md:text-base max-w-md mx-auto leading-relaxed">
      Su presencia es nuestro mejor regalo. Si desean tener un detalle con nosotros,
      ponemos a su disposición las siguientes cuentas.
    </p>

    <div class="grid md:grid-cols-2 gap-5">
      <!-- Luis Velásquez -->
      <div class="gift-card" data-animate="fade-left">
        <div class="gift-card-accent bg-wedding-dark-green"></div>
        <div class="relative z-10">
          <div class="w-11 h-11 mx-auto mb-3 bg-wedding-dark-green/10 rounded-full flex items-center justify-center">
            <span class="font-serif-elegant text-wedding-dark-green text-lg font-bold">L</span>
          </div>
          <h3 class="text-base font-serif-elegant text-wedding-dark-green mb-4">
            Luis Velásquez
          </h3>

          <!-- Cuenta BAC -->
          <div class="account-row">
            <span class="account-bank">BAC</span>
            <span class="account-number">744197341</span>
          </div>

          <!-- Cuenta Atlántida -->
          <div class="account-row">
            <span class="account-bank">Atlántida</span>
            <span class="account-number">2021015978</span>
            <span class="account-type">Ahorros</span>
          </div>
        </div>
      </div>

      <!-- Cesia Mejía -->
      <div class="gift-card" data-animate="fade-right">
        <div class="gift-card-accent bg-wedding-gold"></div>
        <div class="relative z-10">
          <div class="w-11 h-11 mx-auto mb-3 bg-wedding-gold/10 rounded-full flex items-center justify-center">
            <span class="font-serif-elegant text-wedding-gold text-lg font-bold">C</span>
          </div>
          <h3 class="text-base font-serif-elegant text-wedding-dark-green mb-4">
            Cesia Mejía
          </h3>

          <!-- Cuenta BAC -->
          <div class="account-row">
            <span class="account-bank">BAC</span>
            <span class="account-number">758968351</span>
          </div>

          <!-- Cuenta Atlántida -->
          <div class="account-row">
            <span class="account-bank">Atlántida</span>
            <span class="account-number">2020864359</span>
            <span class="account-type">Ahorros</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gift-card {
    position: relative;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    padding: 1.75rem 1.5rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(143, 158, 139, 0.15);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-align: center;
  }

  .gift-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .gift-card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    border-radius: 1.5rem 1.5rem 0 0;
  }

  .account-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.6rem 0.75rem;
    margin-top: 0.5rem;
    background: rgba(249, 247, 241, 0.8);
    border-radius: 0.75rem;
    border: 1px solid rgba(143, 158, 139, 0.1);
  }

  .account-bank {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-wedding-dark-green);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .account-number {
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    color: #374151;
    letter-spacing: 0.05em;
  }

  .account-type {
    width: 100%;
    font-size: 0.65rem;
    color: #9ca3af;
    text-align: right;
  }
</style>
